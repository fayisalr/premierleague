generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Team {
  id      String   @id
  name    String
  rank    String
  winRate String
  img     String
  color   String

  players      Player[]
  homeMatches  Match[] @relation("HomeTeam")
  awayMatches  Match[] @relation("AwayTeam")
  standing     Standing?
}

model Player {
  id       String @id
  name     String
  imageUrl String
  position String
  number   String
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Standing {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  p      Int
  w      Int
  l      Int
  gd     Int
  pts    Int
}

model Match {
  id         String @id
  homeTeamId String
  awayTeamId String
  homeScore  Int?
  awayScore  Int?
  status     String // 'LIVE' | 'UPCOMING' | 'FT'
  date       String
  time       String
  venue      String
  
  // Stats
  possessionHome Int?
  possessionAway Int?
  shotsHome      Int?
  shotsAway      Int?
  foulsHome      Int?
  foulsAway      Int?

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
}

model Photo {
  id      String  @id
  url     String
  caption String?
}

model Setting {
  key   String @id
  value String
}
